+
+    void attachSink(Sink s) {
+        sink = s;
+        synchronized (peaksLock) {
+            // A freshly attached JS context pulls the full table itself.
+            dirtyStart = Integer.MAX_VALUE;
+            dirtyEnd = -1;
+        }
+    }
+
+    void detachSink(Sink s) {
+        if (sink == s) {
+            sink = null;
+        }
+    }
